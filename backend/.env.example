DATABASE_URL=postgresql+psycopg://csn:csn@localhost:5433/csn
# 32자 이상 임의 문자열 (python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET=change-me-to-a-random-string-of-32-chars
# 음성·사진 파일 암호화 키 (uv run python -m app.storage 로 만들기). 잃으면 저장된 파일을 못 읽는다
STORAGE_KEY=
# 보관 기간(일): 확정되지 않은 기록의 음성·사진 / 확정 기록의 전사문·초안
AUDIO_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=180
# fake | local | gemini
AI_PROVIDER=fake
# local
MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# gemini (Google AI Studio 무료 등급 키)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
