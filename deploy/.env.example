# 서비스 주소 (DNS가 이 서버를 가리켜야 HTTPS 인증서를 받는다). 로컬 확인은 localhost
DOMAIN=dolbom.example.com
# 로컬에서 80·443이 쓰이고 있으면 바꾼다
HTTP_PORT=80
HTTPS_PORT=443

# DB 비밀번호 (openssl rand -base64 24)
POSTGRES_PASSWORD=

# 32자 이상 임의 문자열 (openssl rand -base64 48)
JWT_SECRET=
# 음성·사진 암호화 키. 만들기: openssl rand -base64 32 | tr '+/' '-_'
# 잃으면 저장된 파일을 읽을 수 없으니 서버 밖에도 따로 보관
STORAGE_KEY=

# 공개 데모: Gemini 무료 등급 (가상 데이터만 넣을 것)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 무료 등급 한도를 넘지 않게
DAILY_RECORDS_PER_USER=20
DAILY_RECORDS_TOTAL=200
DAILY_SUMMARIES_PER_USER=20
DAILY_SUMMARIES_TOTAL=200

# 처음 한 번 데모 센터·계정(비밀번호 demo1234)·가상 수급자를 만든다
SEED_DEMO=true
